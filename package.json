{
  "name": "git-submodule-extension",
  "displayName": "Git Submodule Extension",
  "description": "Source Control view for Git submodules: nested repositories and gitlink diffs in one Changes tree, everyday Git actions, and safe reattach of detached submodules to their branch.",
  "version": "0.4.12",
  "publisher": "qjohn",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sedlacl/git-submodule-extension.git"
  },
  "bugs": {
    "url": "https://github.com/sedlacl/git-submodule-extension/issues"
  },
  "homepage": "https://github.com/sedlacl/git-submodule-extension#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "submodule",
    "scm",
    "source control"
  ],
  "activationEvents": [
    "onView:scm",
    "onView:gitSubmodule.repos",
    "workspaceContains:**/.git"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Git Submodule",
      "properties": {
        "gitSubmodule.restore.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore submodule branches after parent Git operations when every fail-closed check passes. Never fetches, pulls, pushes, commits, force-updates, or discards files."
        },
        "gitSubmodule.restore.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 10000,
          "description": "Delay in milliseconds before coalescing Git change events into a restore pass."
        },
        "gitSubmodule.autofetch.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Periodically run `git fetch` in every open repository, submodules included, like `git.autofetch` but only after a startup delay. Fetches one repository at a time, never prompts for credentials, and never pulls or changes your files. Turn off `git.autofetch` so repositories are not fetched twice."
        },
        "gitSubmodule.autofetch.periodSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 60,
          "maximum": 86400,
          "description": "Seconds between the end of one automatic fetch pass and the start of the next."
        },
        "gitSubmodule.autofetch.startupDelaySeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 3600,
          "description": "Seconds after the window opens before the first automatic fetch pass, so startup is not slowed by fetching every repository at once."
        },
        "gitSubmodule.fsmonitor.suggest": {
          "type": "boolean",
          "default": true,
          "description": "Time the `git status` runs the extension makes anyway, and when a repository's typical status takes a second or more, offer to turn on Git's fsmonitor there. Nothing is changed without your choice."
        },
        "gitSubmodule.commitMessage.provider": {
          "type": "string",
          "enum": [
            "auto",
            "cursor",
            "claude",
            "gitlens"
          ],
          "enumDescriptions": [
            "First available provider that can target the repository: Cursor AI, then the Claude Code CLI, then GitLens AI; Copilot/built-in commands only when a single repository is open.",
            "Cursor AI (cursor.generateGitCommitMessage).",
            "Claude Code CLI, bundled with the Claude Code extension or found on PATH.",
            "GitLens AI (gitlens.ai.generateCommitMessage)."
          ],
          "default": "auto",
          "description": "AI provider behind Git Submodule: Generate Commit Message and the sparkle in CHANGES with submodules."
        },
        "gitSubmodule.commitMessage.claudeModel": {
          "type": "string",
          "default": "haiku",
          "description": "Model alias or full model name passed to the Claude Code CLI (`--model`) when generating commit messages."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "gitSubmodule.repos",
          "name": "CHANGES with submodules",
          "icon": "$(git-commit)",
          "contextualTitle": "CHANGES with submodules",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gitSubmodule.refresh",
        "title": "Refresh",
        "category": "Git Submodule",
        "icon": "$(refresh)"
      },
      {
        "command": "gitSubmodule.commit",
        "title": "Commit",
        "category": "Git Submodule",
        "icon": "$(check)"
      },
      {
        "command": "gitSubmodule.generateSubmoduleChore",
        "title": "Generate Submodule Chore",
        "category": "Git Submodule",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitSubmodule.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Git Submodule",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitSubmodule.checkoutBranch",
        "title": "Checkout Branch...",
        "category": "Git Submodule",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitSubmodule.copyBranchName",
        "title": "Copy Branch Name",
        "category": "Git Submodule",
        "icon": "$(copy)"
      },
      {
        "command": "gitSubmodule.fetch",
        "title": "Fetch",
        "category": "Git Submodule",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitSubmodule.pull",
        "title": "Pull",
        "category": "Git Submodule",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitSubmodule.pullRecurseSubmodules",
        "title": "Pull (Recurse Submodules)",
        "category": "Git Submodule",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitSubmodule.sync",
        "title": "Sync",
        "category": "Git Submodule",
        "icon": "$(sync)"
      },
      {
        "command": "gitSubmodule.publish",
        "title": "Publish Branch...",
        "category": "Git Submodule",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitSubmodule.viewAsTree",
        "title": "View as Tree",
        "category": "Git Submodule",
        "icon": "$(list-tree)"
      },
      {
        "command": "gitSubmodule.viewAsList",
        "title": "View as List",
        "category": "Git Submodule",
        "icon": "$(list-flat)"
      },
      {
        "command": "gitSubmodule.openDiff",
        "title": "Open Changes",
        "category": "Git Submodule",
        "icon": "$(diff)"
      },
      {
        "command": "gitSubmodule.openChange",
        "title": "Open Changes",
        "category": "Git Submodule",
        "icon": "$(diff)"
      },
      {
        "command": "gitSubmodule.openAllChanges",
        "title": "Open All Changes",
        "category": "Git Submodule",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitSubmodule.openFile",
        "title": "Open File",
        "category": "Git Submodule",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitSubmodule.openHEADFile",
        "title": "Open File (HEAD)",
        "category": "Git Submodule"
      },
      {
        "command": "gitSubmodule.copyPath",
        "title": "Copy Path",
        "category": "Git Submodule"
      },
      {
        "command": "gitSubmodule.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Git Submodule"
      },
      {
        "command": "gitSubmodule.stage",
        "title": "Stage Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.stageAll",
        "title": "Stage All Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.stageAllTracked",
        "title": "Stage All Tracked Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.stageAllUntracked",
        "title": "Stage All Untracked Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.stageAllMerge",
        "title": "Stage All Merge Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.unstage",
        "title": "Unstage Changes",
        "category": "Git Submodule",
        "icon": "$(remove)"
      },
      {
        "command": "gitSubmodule.unstageAll",
        "title": "Unstage All Changes",
        "category": "Git Submodule",
        "icon": "$(remove)"
      },
      {
        "command": "gitSubmodule.clean",
        "title": "Discard Changes",
        "category": "Git Submodule",
        "icon": "$(discard)"
      },
      {
        "command": "gitSubmodule.cleanAll",
        "title": "Discard All Changes",
        "category": "Git Submodule",
        "icon": "$(discard)"
      },
      {
        "command": "gitSubmodule.cleanAllTracked",
        "title": "Discard All Tracked Changes",
        "category": "Git Submodule",
        "icon": "$(discard)"
      },
      {
        "command": "gitSubmodule.cleanAllUntracked",
        "title": "Discard All Untracked Changes",
        "category": "Git Submodule",
        "icon": "$(discard)"
      },
      {
        "command": "gitSubmodule.retryRestore",
        "title": "Retry Branch Restore",
        "category": "Git Submodule",
        "icon": "$(debug-restart)"
      },
      {
        "command": "gitSubmodule.fetchRemote",
        "title": "Fetch Submodule Remote",
        "category": "Git Submodule",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitSubmodule.analyzeFsmonitor",
        "title": "Analyze fsmonitor for Repositories",
        "category": "Git Submodule"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitSubmodule.openDiff",
          "when": "false"
        },
        {
          "command": "gitSubmodule.openChange",
          "when": "false"
        },
        {
          "command": "gitSubmodule.openAllChanges",
          "when": "false"
        },
        {
          "command": "gitSubmodule.openFile",
          "when": "false"
        },
        {
          "command": "gitSubmodule.openHEADFile",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stage",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stageAll",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stageAllTracked",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stageAllUntracked",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stageAllMerge",
          "when": "false"
        },
        {
          "command": "gitSubmodule.unstage",
          "when": "false"
        },
        {
          "command": "gitSubmodule.unstageAll",
          "when": "false"
        },
        {
          "command": "gitSubmodule.clean",
          "when": "false"
        },
        {
          "command": "gitSubmodule.cleanAll",
          "when": "false"
        },
        {
          "command": "gitSubmodule.cleanAllTracked",
          "when": "false"
        },
        {
          "command": "gitSubmodule.cleanAllUntracked",
          "when": "false"
        },
        {
          "command": "gitSubmodule.commit",
          "when": "false"
        },
        {
          "command": "gitSubmodule.generateSubmoduleChore",
          "when": "false"
        },
        {
          "command": "gitSubmodule.sync",
          "when": "false"
        },
        {
          "command": "gitSubmodule.publish",
          "when": "false"
        },
        {
          "command": "gitSubmodule.copyPath",
          "when": "false"
        },
        {
          "command": "gitSubmodule.copyRelativePath",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "gitSubmodule.generateCommitMessage",
          "when": "scmProvider == git && gitSubmodule.commitMessageScmTitleAction",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "gitSubmodule.commit",
          "when": "view == gitSubmodule.repos",
          "group": "navigation@1"
        },
        {
          "command": "gitSubmodule.refresh",
          "when": "view == gitSubmodule.repos",
          "group": "navigation@2"
        },
        {
          "command": "gitSubmodule.retryRestore",
          "when": "view == gitSubmodule.repos",
          "group": "navigation@3"
        },
        {
          "command": "gitSubmodule.viewAsList",
          "when": "view == gitSubmodule.repos && gitSubmodule.viewMode == tree",
          "group": "navigation@4"
        },
        {
          "command": "gitSubmodule.viewAsTree",
          "when": "view == gitSubmodule.repos && gitSubmodule.viewMode != tree",
          "group": "navigation@4"
        }
      ],
      "webview/context": [
        {
          "command": "gitSubmodule.checkoutBranch",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.checkoutBranch",
          "group": "1_repository@1"
        },
        {
          "command": "gitSubmodule.copyBranchName",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.copyBranchName",
          "group": "1_repository@1"
        },
        {
          "command": "gitSubmodule.fetch",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.fetch",
          "group": "1_repository@2"
        },
        {
          "command": "gitSubmodule.pull",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.pull",
          "group": "1_repository@3"
        },
        {
          "command": "gitSubmodule.pullRecurseSubmodules",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.pullRecurseSubmodules",
          "group": "1_repository@3"
        },
        {
          "command": "gitSubmodule.generateSubmoduleChore",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.generateSubmoduleChore",
          "group": "1_repository@4"
        },
        {
          "command": "gitSubmodule.openAllChanges",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.openAllChanges",
          "group": "1_repository@5"
        },
        {
          "command": "gitSubmodule.stageAll",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.stageAll",
          "group": "2_changeGroup@10"
        },
        {
          "command": "gitSubmodule.stageAllMerge",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.stageAllMerge",
          "group": "2_changeGroup@10"
        },
        {
          "command": "gitSubmodule.stageAllTracked",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.stageAllTracked",
          "group": "2_changeGroup@10"
        },
        {
          "command": "gitSubmodule.stageAllUntracked",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.stageAllUntracked",
          "group": "2_changeGroup@10"
        },
        {
          "command": "gitSubmodule.unstageAll",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.unstageAll",
          "group": "2_changeGroup@10"
        },
        {
          "command": "gitSubmodule.cleanAll",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.cleanAll",
          "group": "2_changeGroup@11"
        },
        {
          "command": "gitSubmodule.cleanAllTracked",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.cleanAllTracked",
          "group": "2_changeGroup@11"
        },
        {
          "command": "gitSubmodule.cleanAllUntracked",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.cleanAllUntracked",
          "group": "2_changeGroup@11"
        },
        {
          "command": "gitSubmodule.openChange",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.openChange",
          "group": "3_open@20"
        },
        {
          "command": "gitSubmodule.openFile",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.openFile",
          "group": "3_open@21"
        },
        {
          "command": "gitSubmodule.openHEADFile",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.openHEADFile",
          "group": "3_open@22"
        },
        {
          "command": "gitSubmodule.clean",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.clean",
          "group": "4_change@30"
        },
        {
          "command": "gitSubmodule.stage",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.stage",
          "group": "4_change@30"
        },
        {
          "command": "gitSubmodule.unstage",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.unstage",
          "group": "4_change@30"
        },
        {
          "command": "gitSubmodule.copyPath",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.copyPath",
          "group": "5_copy@40"
        },
        {
          "command": "gitSubmodule.copyRelativePath",
          "when": "webviewId == gitSubmodule.repos && gitSubmodule.menu.copyRelativePath",
          "group": "5_copy@41"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitSubmodule.repos",
        "contents": "No Git workspace folders found."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:icon": "convert -background none -density 384 media/icon.svg -resize 128x128 media/icon.png",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:extension-host": "tsx scripts/run-extension-tests.ts",
    "create-ui-fixture": "tsx scripts/create-ui-fixture.ts",
    "dev:ui": "tsx scripts/dev-ui.ts",
    "dev:cursor": "tsx scripts/dev-ui.ts --host=cursor",
    "profile:cursor": "tsx scripts/profile-cursor-ui.ts",
    "dev:ui:reset": "tsx scripts/create-ui-fixture.ts --force",
    "package": "npm run build:icon && npm run package:ci",
    "package:ci": "npm run build && vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:set": "npm version --no-git-tag-version",
    "capture-readme-screenshot": "tsx scripts/capture-readme-screenshot.ts",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.29",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.27.0",
    "ovsx": "^0.10.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36"
  }
}
