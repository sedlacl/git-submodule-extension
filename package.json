{
  "name": "git-submodule-extension",
  "displayName": "Git Submodule Extension",
  "description": "Hierarchical Changes view for Git repositories and submodules, with gitlink pointer diffs nested under the matching change row and safe branch restore.",
  "version": "0.2.1",
  "publisher": "qjohn",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sedlacl/git-submodule-extension.git"
  },
  "bugs": {
    "url": "https://github.com/sedlacl/git-submodule-extension/issues"
  },
  "homepage": "https://github.com/sedlacl/git-submodule-extension#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "submodule",
    "scm",
    "source control"
  ],
  "activationEvents": [
    "onView:scm",
    "onView:gitSubmodule.repos",
    "workspaceContains:**/.git"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Git Submodule",
      "properties": {
        "gitSubmodule.restore.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore submodule branches after parent Git operations when every fail-closed check passes. Never fetches, pulls, pushes, commits, force-updates, or discards files."
        },
        "gitSubmodule.restore.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 10000,
          "description": "Delay in milliseconds before coalescing Git change events into a restore pass."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "gitSubmodule.repos",
          "name": "CHANGES with submodules",
          "icon": "$(git-commit)",
          "contextualTitle": "CHANGES with submodules",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gitSubmodule.refresh",
        "title": "Refresh",
        "category": "Git Submodule",
        "icon": "$(refresh)"
      },
      {
        "command": "gitSubmodule.commit",
        "title": "Commit",
        "category": "Git Submodule",
        "icon": "$(check)"
      },
      {
        "command": "gitSubmodule.generateSubmoduleChore",
        "title": "Generate Submodule Chore",
        "category": "Git Submodule",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitSubmodule.checkoutBranch",
        "title": "Checkout Branch...",
        "category": "Git Submodule",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitSubmodule.fetch",
        "title": "Fetch",
        "category": "Git Submodule",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitSubmodule.pull",
        "title": "Pull",
        "category": "Git Submodule",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitSubmodule.sync",
        "title": "Sync",
        "category": "Git Submodule",
        "icon": "$(sync)"
      },
      {
        "command": "gitSubmodule.publish",
        "title": "Publish Branch...",
        "category": "Git Submodule",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitSubmodule.viewAsTree",
        "title": "View as Tree",
        "category": "Git Submodule",
        "icon": "$(list-tree)"
      },
      {
        "command": "gitSubmodule.viewAsList",
        "title": "View as List",
        "category": "Git Submodule",
        "icon": "$(list-flat)"
      },
      {
        "command": "gitSubmodule.openDiff",
        "title": "Open Changes",
        "category": "Git Submodule",
        "icon": "$(diff)"
      },
      {
        "command": "gitSubmodule.openChange",
        "title": "Open Changes",
        "category": "Git Submodule",
        "icon": "$(diff)"
      },
      {
        "command": "gitSubmodule.openAllChanges",
        "title": "Open All Changes",
        "category": "Git Submodule",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitSubmodule.openFile",
        "title": "Open File",
        "category": "Git Submodule",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitSubmodule.openHEADFile",
        "title": "Open File (HEAD)",
        "category": "Git Submodule"
      },
      {
        "command": "gitSubmodule.stage",
        "title": "Stage Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.stageAll",
        "title": "Stage All Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.stageAllTracked",
        "title": "Stage All Tracked Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.stageAllUntracked",
        "title": "Stage All Untracked Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.stageAllMerge",
        "title": "Stage All Merge Changes",
        "category": "Git Submodule",
        "icon": "$(add)"
      },
      {
        "command": "gitSubmodule.unstage",
        "title": "Unstage Changes",
        "category": "Git Submodule",
        "icon": "$(remove)"
      },
      {
        "command": "gitSubmodule.unstageAll",
        "title": "Unstage All Changes",
        "category": "Git Submodule",
        "icon": "$(remove)"
      },
      {
        "command": "gitSubmodule.clean",
        "title": "Discard Changes",
        "category": "Git Submodule",
        "icon": "$(discard)"
      },
      {
        "command": "gitSubmodule.cleanAll",
        "title": "Discard All Changes",
        "category": "Git Submodule",
        "icon": "$(discard)"
      },
      {
        "command": "gitSubmodule.cleanAllTracked",
        "title": "Discard All Tracked Changes",
        "category": "Git Submodule",
        "icon": "$(discard)"
      },
      {
        "command": "gitSubmodule.cleanAllUntracked",
        "title": "Discard All Untracked Changes",
        "category": "Git Submodule",
        "icon": "$(discard)"
      },
      {
        "command": "gitSubmodule.retryRestore",
        "title": "Retry Branch Restore",
        "category": "Git Submodule",
        "icon": "$(debug-restart)"
      },
      {
        "command": "gitSubmodule.fetchRemote",
        "title": "Fetch Submodule Remote",
        "category": "Git Submodule",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitSubmodule.openDiff",
          "when": "false"
        },
        {
          "command": "gitSubmodule.openChange",
          "when": "false"
        },
        {
          "command": "gitSubmodule.openAllChanges",
          "when": "false"
        },
        {
          "command": "gitSubmodule.openFile",
          "when": "false"
        },
        {
          "command": "gitSubmodule.openHEADFile",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stage",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stageAll",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stageAllTracked",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stageAllUntracked",
          "when": "false"
        },
        {
          "command": "gitSubmodule.stageAllMerge",
          "when": "false"
        },
        {
          "command": "gitSubmodule.unstage",
          "when": "false"
        },
        {
          "command": "gitSubmodule.unstageAll",
          "when": "false"
        },
        {
          "command": "gitSubmodule.clean",
          "when": "false"
        },
        {
          "command": "gitSubmodule.cleanAll",
          "when": "false"
        },
        {
          "command": "gitSubmodule.cleanAllTracked",
          "when": "false"
        },
        {
          "command": "gitSubmodule.cleanAllUntracked",
          "when": "false"
        },
        {
          "command": "gitSubmodule.commit",
          "when": "false"
        },
        {
          "command": "gitSubmodule.generateSubmoduleChore",
          "when": "false"
        },
        {
          "command": "gitSubmodule.sync",
          "when": "false"
        },
        {
          "command": "gitSubmodule.publish",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gitSubmodule.commit",
          "when": "view == gitSubmodule.repos",
          "group": "navigation@1"
        },
        {
          "command": "gitSubmodule.refresh",
          "when": "view == gitSubmodule.repos",
          "group": "navigation@2"
        },
        {
          "command": "gitSubmodule.retryRestore",
          "when": "view == gitSubmodule.repos",
          "group": "navigation@3"
        },
        {
          "command": "gitSubmodule.viewAsList",
          "when": "view == gitSubmodule.repos && gitSubmodule.viewMode == tree",
          "group": "navigation@4"
        },
        {
          "command": "gitSubmodule.viewAsTree",
          "when": "view == gitSubmodule.repos && gitSubmodule.viewMode != tree",
          "group": "navigation@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitSubmodule.repos",
        "contents": "No Git workspace folders found."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:icon": "convert -background none -density 384 media/icon.svg -resize 128x128 media/icon.png",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:extension-host": "tsx scripts/run-extension-tests.ts",
    "create-ui-fixture": "tsx scripts/create-ui-fixture.ts",
    "dev:ui": "tsx scripts/dev-ui.ts",
    "dev:cursor": "tsx scripts/dev-ui.ts --host=cursor",
    "profile:cursor": "tsx scripts/profile-cursor-ui.ts",
    "dev:ui:reset": "tsx scripts/create-ui-fixture.ts --force",
    "package": "npm run build:icon && npm run package:ci",
    "package:ci": "npm run build && vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:set": "npm version --no-git-tag-version",
    "capture-readme-screenshot": "tsx scripts/capture-readme-screenshot.ts",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.29",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.4.2",
    "esbuild": "^0.25.5",
    "eslint": "^9.27.0",
    "ovsx": "^0.10.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36"
  }
}
